# Dove si espone il laboratorio.
#
# 127.0.0.1  -> solo questa macchina (valore predefinito)
# <indirizzo Tailscale> -> tutta la tailnet, cioè i tuoi dispositivi e nessun altro
#
# L'indirizzo di Tailscale si legge con `tailscale ip -4`.
ADU_BIND_IP=127.0.0.1

# Origini ammesse dall'API, separate da virgola. Deve corrispondere all'indirizzo con cui
# apri il portale nel browser, altrimenti il browser blocca le risposte.
ADU_CORS_ORIGINS=http://127.0.0.1:8080
